{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@carbo/chat": [
        "../../packages/chat/src/index.ts"
      ],
      "@carbo/shell": [
        "../../packages/shell/src/index.ts"
      ],
      "@carbo/call": [
        "../../packages/call/src/index.ts"
      ],
      "livekit-client": [
        "./node_modules/livekit-client"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    // "vitest/globals" saiu daqui: o vitest não é dependência do app e não há
    // nenhum teste. Com ele, `tsc` falhava logo na entrada — o que fazia o
    // typecheck simplesmente nunca rodar, e um `user` inexistente foi para
    // produção sem ninguém ver. `vite build` NÃO typechecka: ele remove os
    // tipos com esbuild.
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}